// https://docs.prisma.io/docs/orm/v7/core-concepts/data-modeling

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
	id				Int @id @unique
	type			String
	permisions	String
	name			String
	surname		String
	email			String
	phone			String
}

model Customer {
	id				Int @id @unique
	name			String
	surname		String
	email			String 
	phone			Int
	birthday		DateTime @default(now())
}

model Product {
  id_product	Int @id
  name			String
  description 	String?
  price       	Int
  stock			Int
  createdAt   	DateTime @default(now())
}

model OrderStatus {
	id Int @id
}

model Orders {
	id					Int @id
	total				String
	date				DateTime
	status_fk		Int // Foreing Key
	payment			String?		
	id_user			Int
	id_sellsman		Int
}

model OrderDetail {
	id_detail		Int @id
	id_order_fk		Int
	id_product_fk	Int
}

